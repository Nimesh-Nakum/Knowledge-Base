---
import TagBadge from './TagBadge.astro';

interface Props {
	title: string;
	description: string;
	href: string;
	github?: string;
	status?: string;
	technologies?: string[];
	tags?: string[];
}

const { title, description, href, github, status = 'active', technologies = [], tags = [] } = Astro.props;

const statusStyles: Record<string, { bg: string; text: string }> = {
	active: { bg: 'rgba(34, 197, 94, 0.1)', text: '#22C55E' },
	completed: { bg: 'rgba(59, 130, 246, 0.1)', text: '#3B82F6' },
	archived: { bg: 'rgba(107, 114, 128, 0.1)', text: '#6B7280' },
};

const s = statusStyles[status] || statusStyles.active;
---

<div class="project-card">
	<div class="card-header">
		<a href={href} class="card-title-link">
			<h3 class="card-title">{title}</h3>
		</a>
		<span class="status-badge" style={`background:${s.bg};color:${s.text}`}>
			{status.charAt(0).toUpperCase() + status.slice(1)}
		</span>
	</div>

	<p class="card-desc">{description}</p>

	{technologies.length > 0 && (
		<div class="tech-list">
			{technologies.map((tech) => (
				<span class="tech-item">{tech}</span>
			))}
		</div>
	)}

	<div class="card-actions">
		<a href={href} class="card-link">View Details →</a>
		{github && (
			<a href={github} target="_blank" rel="noopener" class="github-link" aria-label="View on GitHub">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
				GitHub
			</a>
		)}
	</div>
</div>

<style>
	.project-card {
		padding: var(--space-xl);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		transition: border-color var(--transition-base), transform var(--transition-base);
	}

	.project-card:hover {
		border-color: var(--accent-border);
		transform: translateY(-2px);
	}

	.card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-md);
		margin-bottom: var(--space-sm);
	}

	.card-title-link {
		text-decoration: none;
	}

	.card-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--text);
		line-height: 1.3;
	}

	.card-title-link:hover .card-title {
		color: var(--accent-light);
	}

	.status-badge {
		flex-shrink: 0;
		padding: 2px 8px;
		border-radius: 9999px;
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}

	.card-desc {
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin-bottom: var(--space-md);
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-bottom: var(--space-md);
	}

	.tech-item {
		padding: 2px 8px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.75rem;
		color: var(--text-muted);
		font-family: var(--font-code);
	}

	.card-actions {
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		padding-top: var(--space-md);

	}

	.card-link {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--accent-light);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.card-link:hover {
		color: var(--accent);
	}

	.github-link {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		font-size: 0.8125rem;
		color: var(--text-dim);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.github-link:hover {
		color: var(--text);
	}
</style>
