---
import { NAV_ITEMS, AUTHOR } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-grid">
			<!-- Brand -->
			<div class="footer-brand">
				<a href="/" class="footer-logo">
					<span class="logo-icon" style="color: var(--accent); font-family: var(--font-code); font-size: 1.125rem;">&gt;_</span>
					Knowledge Base
				</a>
				<p class="footer-desc">Security research, technical articles, and educational content on offensive security.</p>
			</div>

			<!-- Navigation -->
			<div class="footer-col">
				<h4 class="footer-heading">Navigation</h4>
				<ul class="footer-links">
					{NAV_ITEMS.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</div>

			<!-- Series -->
			<div class="footer-col">
				<h4 class="footer-heading">Series</h4>
				<ul class="footer-links">
					<li><a href="/series/windows-internals/">Windows Internals</a></li>
					<li><a href="/series/active-directory/">Active Directory</a></li>
					<li><a href="/series/windows-security/">Windows Security</a></li>
					<li><a href="/series/web-security/">Web Security</a></li>
					<li><a href="/series/malware-development/">Malware Development</a></li>
				</ul>
			</div>

			<!-- Connect -->
			<div class="footer-col">
				<h4 class="footer-heading">Connect</h4>
				<ul class="footer-links">
					{AUTHOR.github && <li><a href={AUTHOR.github} target="_blank" rel="noopener">GitHub</a></li>}
					{AUTHOR.linkedin && <li><a href={AUTHOR.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>}
					{AUTHOR.medium && <li><a href={AUTHOR.medium} target="_blank" rel="noopener">Medium</a></li>}
					{AUTHOR.twitter && <li><a href={AUTHOR.twitter} target="_blank" rel="noopener">Twitter</a></li>}
					{AUTHOR.email && <li><a href={`mailto:${AUTHOR.email}`}>Email</a></li>}
					<li><a href="/rss.xml">RSS Feed</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<p>&copy; {year} {AUTHOR.name}. All rights reserved.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {

		background: var(--bg-secondary);
		margin-top: var(--space-3xl);
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--space-3xl) var(--space-lg) var(--space-xl);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1fr;
		gap: var(--space-2xl);
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		color: var(--text);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.9375rem;
		text-decoration: none;
		margin-bottom: var(--space-md);
	}

	.footer-logo:hover { color: var(--accent-light); }

	.footer-desc {
		color: var(--text-dim);
		font-size: 0.875rem;
		line-height: 1.6;
		max-width: 280px;
	}

	.footer-heading {
		color: var(--text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--space-md);
		font-family: var(--font-body);
	}

	.footer-links {
		list-style: none;
		padding: 0;
	}

	.footer-links li {
		margin-bottom: var(--space-sm);
	}

	.footer-links a {
		color: var(--text-dim);
		font-size: 0.875rem;
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.footer-links a:hover {
		color: var(--text);
	}

	.footer-bottom {
		margin-top: var(--space-2xl);
		padding-top: var(--space-lg);

	}

	.footer-bottom p {
		color: var(--text-dim);
		font-size: 0.8125rem;
		margin: 0;
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-xl);
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
