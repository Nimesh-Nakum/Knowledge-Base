---
/**
 * SearchDialog — Full-screen search overlay with instant filtering.
 * Activated by Ctrl+K or clicking the search trigger button.
 * Loads search index lazily on first open.
 */
---

<div class="search-overlay" id="search-overlay" role="dialog" aria-label="Search" aria-modal="true">
	<div class="search-container">
		<div class="search-header">
			<div class="search-input-wrapper">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input
					type="text"
					id="search-input"
					class="search-input"
					placeholder="Search Windows APIs, Kerberos, Process Hollowing..."
					autocomplete="off"
					autofocus
				/>
				<kbd class="search-esc">Esc</kbd>
			</div>
		</div>
		<div class="search-results" id="search-results">
			<div class="search-empty">
				<p>Start typing to search across all content.</p>
			</div>
		</div>
	</div>
</div>

<style>
	.search-overlay {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 200;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(4px);
		padding: 15vh var(--space-md) var(--space-md);
		align-items: flex-start;
		justify-content: center;
	}

	.search-overlay.open {
		display: flex;
	}

	.search-container {
		width: 100%;
		max-width: 640px;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		overflow: hidden;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
	}

	.search-header {
		display: flex;
		align-items: center;
		padding: var(--space-md);
	}

	.search-input-wrapper {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.search-input-wrapper svg {
		color: var(--text-dim);
		flex-shrink: 0;
	}

	.search-input {
		flex: 1;
		background: transparent;
		border: none;
		color: var(--text);
		font-size: 1rem;
		font-family: var(--font-body);
		outline: none;
	}

	.search-input::placeholder {
		color: var(--text-dim);
	}

	.search-esc {
		flex-shrink: 0;
		padding: 2px 6px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.6875rem;
		font-family: var(--font-code);
		color: var(--text-dim);
	}

	.search-results {
		max-height: 400px;
		overflow-y: auto;
		padding: var(--space-sm);
	}

	.search-empty {
		padding: var(--space-xl);
		text-align: center;
	}

	.search-empty p {
		color: var(--text-dim);
		font-size: 0.875rem;
		margin: 0;
	}

	/* Results rendered via JS */
	:global(.search-result-item) {
		display: block;
		padding: var(--space-sm) var(--space-md);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	:global(.search-result-item:hover),
	:global(.search-result-item.focused) {
		background: var(--bg-hover);
	}

	:global(.search-result-title) {
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--text);
		margin-bottom: 2px;
	}

	:global(.search-result-desc) {
		font-size: 0.8125rem;
		color: var(--text-dim);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.search-result-type) {
		font-size: 0.6875rem;
		color: var(--accent-light);
		text-transform: uppercase;
		font-weight: 600;
		letter-spacing: 0.05em;
	}

	:global(.search-no-results) {
		padding: var(--space-xl);
		text-align: center;
		color: var(--text-dim);
		font-size: 0.875rem;
	}
</style>

<script is:inline>
(function () {
	var overlay = document.getElementById('search-overlay');
	var input = document.getElementById('search-input');
	var results = document.getElementById('search-results');
	var trigger = document.getElementById('search-trigger');
	var searchIndex = null;
	var focusedIndex = -1;

	function openSearch() {
		if (!overlay) return;
		var main = document.getElementById('main-content');
		overlay.classList.add('open');
		document.body.style.overflow = 'hidden';
		if (main) main.setAttribute('aria-hidden', 'true');
		setTimeout(function () { input && input.focus(); }, 50);
		if (!searchIndex) loadIndex();
	}

	function closeSearch() {
		if (!overlay) return;
		var main = document.getElementById('main-content');
		overlay.classList.remove('open');
		document.body.style.overflow = '';
		if (main) main.removeAttribute('aria-hidden');
		if (input) input.value = '';
		if (results) results.innerHTML = '<div class="search-empty"><p>Start typing to search across all content.</p></div>';
		focusedIndex = -1;
	}

	function loadIndex() {
		fetch('/search.json')
			.then(function (r) { return r.json(); })
			.then(function (data) { searchIndex = data; })
			.catch(function () { searchIndex = []; });
	}

	function doSearch(query) {
		if (!results || !searchIndex) return;
		if (!query.trim()) {
			results.innerHTML = '<div class="search-empty"><p>Start typing to search across all content.</p></div>';
			focusedIndex = -1;
			return;
		}

		var q = query.toLowerCase();
		var matches = searchIndex.filter(function (item) {
			return item.title.toLowerCase().includes(q) ||
				item.description.toLowerCase().includes(q) ||
				(item.tags && item.tags.some(function (t) { return t.toLowerCase().includes(q); }));
		}).slice(0, 10);

		if (matches.length === 0) {
			results.innerHTML = '<div class="search-no-results">No results found for "' + query + '"</div>';
			focusedIndex = -1;
			return;
		}

		results.innerHTML = matches.map(function (item) {
			return '<a href="' + item.href + '" class="search-result-item">' +
				'<div class="search-result-type">' + item.type + '</div>' +
				'<div class="search-result-title">' + item.title + '</div>' +
				'<div class="search-result-desc">' + item.description + '</div>' +
				'</a>';
		}).join('');
		focusedIndex = -1;
	}

	/* Event: open */
	if (trigger) trigger.addEventListener('click', openSearch);

	/* Event: close on backdrop click */
	if (overlay) {
		overlay.addEventListener('click', function (e) {
			if (e.target === overlay) closeSearch();
		});
	}

	/* Event: keyboard */
	document.addEventListener('keydown', function (e) {
		if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
			e.preventDefault();
			overlay && overlay.classList.contains('open') ? closeSearch() : openSearch();
		}
		if (e.key === 'Escape' && overlay && overlay.classList.contains('open')) {
			closeSearch();
		}
		/* Arrow navigation */
		if (overlay && overlay.classList.contains('open')) {
			var items = results ? results.querySelectorAll('.search-result-item') : [];
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				focusedIndex = Math.min(focusedIndex + 1, items.length - 1);
				items.forEach(function (el, i) { el.classList.toggle('focused', i === focusedIndex); });
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				focusedIndex = Math.max(focusedIndex - 1, 0);
				items.forEach(function (el, i) { el.classList.toggle('focused', i === focusedIndex); });
			} else if (e.key === 'Enter' && focusedIndex >= 0 && items[focusedIndex]) {
				e.preventDefault();
				items[focusedIndex].click();
			}
		}
	});

	/* Event: input */
	if (input) {
		input.addEventListener('input', function () {
			doSearch(input.value);
		});
	}
})();
</script>
