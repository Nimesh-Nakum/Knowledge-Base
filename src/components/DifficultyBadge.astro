---
interface Props {
	difficulty: string;
}

const { difficulty } = Astro.props;

const colors: Record<string, { bg: string; text: string; border: string }> = {
	beginner: { bg: 'rgba(34, 197, 94, 0.1)', text: '#22C55E', border: 'rgba(34, 197, 94, 0.2)' },
	easy: { bg: 'rgba(34, 197, 94, 0.1)', text: '#22C55E', border: 'rgba(34, 197, 94, 0.2)' },
	intermediate: { bg: 'rgba(245, 158, 11, 0.1)', text: '#F59E0B', border: 'rgba(245, 158, 11, 0.2)' },
	medium: { bg: 'rgba(245, 158, 11, 0.1)', text: '#F59E0B', border: 'rgba(245, 158, 11, 0.2)' },
	advanced: { bg: 'rgba(239, 68, 68, 0.1)', text: '#EF4444', border: 'rgba(239, 68, 68, 0.2)' },
	hard: { bg: 'rgba(239, 68, 68, 0.1)', text: '#EF4444', border: 'rgba(239, 68, 68, 0.2)' },
	insane: { bg: 'rgba(168, 85, 247, 0.1)', text: '#A855F7', border: 'rgba(168, 85, 247, 0.2)' },
};

const style = colors[difficulty.toLowerCase()] || colors.intermediate;
const label = difficulty.charAt(0).toUpperCase() + difficulty.slice(1);
---

<span
	class="difficulty-badge"
	style={`background:${style.bg};color:${style.text};border-color:${style.border}`}
>
	{label}
</span>

<style>
	.difficulty-badge {
		display: inline-flex;
		align-items: center;
		padding: 2px 10px;
		border: 1px solid;
		border-radius: var(--radius-sm);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
</style>
