---
import PageLayout from '../layouts/PageLayout.astro';
import { AUTHOR } from '../consts';
---

<PageLayout title="About" description="Security researcher focused on Windows Internals, Active Directory, and offensive security.">
	<div class="about-page">
		<div class="about-header">
			<div class="profile-avatar">
				<span class="avatar-placeholder">NN</span>
			</div>
			<div class="profile-info">
				<h1 class="profile-name">{AUTHOR.name}</h1>
				<p class="profile-title">Security Researcher & Offensive Security Engineer</p>
				<p class="profile-bio">{AUTHOR.bio}</p>
				<div class="profile-links">
					{AUTHOR.github && <a href={AUTHOR.github} target="_blank" rel="noopener" class="profile-link">GitHub</a>}
					{AUTHOR.linkedin && <a href={AUTHOR.linkedin} target="_blank" rel="noopener" class="profile-link">LinkedIn</a>}
					{AUTHOR.medium && <a href={AUTHOR.medium} target="_blank" rel="noopener" class="profile-link">Medium</a>}
					{AUTHOR.twitter && <a href={AUTHOR.twitter} target="_blank" rel="noopener" class="profile-link">Twitter</a>}
					{AUTHOR.email && <a href={`mailto:${AUTHOR.email}`} class="profile-link">Email</a>}
				</div>
			</div>
		</div>

		<section class="about-section">
			<h2>Focus Areas</h2>
			<div class="skills-grid">
				<div class="skill-card">
					<h3>🪟 Windows Internals</h3>
					<p>Deep understanding of Windows architecture, kernel internals, processes, threads, and memory management.</p>
				</div>
				<div class="skill-card">
					<h3>🏢 Active Directory</h3>
					<p>Active Directory security, Kerberos authentication, LDAP, Group Policy, and enterprise attack paths.</p>
				</div>
				<div class="skill-card">
					<h3>🛡️ Offensive Security</h3>
					<p>Red Team operations, penetration testing, exploit development, and adversary simulation.</p>
				</div>
				<div class="skill-card">
					<h3>🔬 Malware Research</h3>
					<p>Malware analysis, reverse engineering, evasion techniques, and custom tool development.</p>
				</div>
			</div>
		</section>

		<section class="about-section">
			<h2>Certifications</h2>
			<p class="placeholder-text">Certifications will be listed here.</p>
		</section>

		<section class="about-section">
			<h2>Experience</h2>
			<p class="placeholder-text">Professional experience will be listed here.</p>
		</section>
	</div>
</PageLayout>

<style>
	.about-page {
		max-width: 800px;
	}

	.about-header {
		display: flex;
		gap: var(--space-xl);
		align-items: flex-start;
		margin-bottom: var(--space-3xl);
		padding-bottom: var(--space-2xl);
	}

	.profile-avatar {
		flex-shrink: 0;
	}

	.avatar-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 96px;
		height: 96px;
		background: var(--accent-red-bg);
		border: 2px solid var(--accent-red);
		border-radius: 50%;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent-red);
		font-family: var(--font-heading);
	}

	.profile-name {
		font-size: 1.75rem;
		margin-bottom: var(--space-xs);
	}

	.profile-title {
		color: var(--accent-red);
		font-size: 1rem;
		font-weight: 500;
		margin-bottom: var(--space-md);
	}

	.profile-bio {
		color: var(--text-muted);
		font-size: 0.9375rem;
		line-height: 1.7;
		margin-bottom: var(--space-md);
	}

	.profile-links {
		display: flex;
		gap: var(--space-md);
		flex-wrap: wrap;
	}

	.profile-link {
		padding: 6px 16px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--text-muted);
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
		transition: color var(--transition-fast), border-color var(--transition-fast);
	}

	.profile-link:hover {
		color: var(--accent-red);
		border-color: var(--accent-red);
	}

	.about-section {
		margin-bottom: var(--space-2xl);
	}

	.about-section h2 {
		font-size: 1.375rem;
		margin-bottom: var(--space-lg);
		padding-bottom: var(--space-sm);
		color: var(--accent-red);
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-md);
	}

	.skill-card {
		padding: var(--space-lg);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}

	.skill-card h3 {
		font-size: 1rem;
		margin-bottom: var(--space-sm);
	}

	.skill-card p {
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.placeholder-text {
		color: var(--text-dim);
		font-style: italic;
	}

	@media (max-width: 768px) {
		.about-header {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		.profile-links {
			justify-content: center;
		}

		.skills-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
